reak"},{"type":"text","text":"願うこと 辛くても 立ち向かう 勇気君に貰った だから行くね"},{"type":"hardBreak"},{"type":"text","text":"夢の中 目覚めたら また会えるよ"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"遠い 記憶 胸に秘め 歌う"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"儚くたゆたう 世界を 君の手で 守ったから"},{"type":"hardBreak"},{"type":"text","text":"今はただ 翼をたたんで ゆっくり 眠りなさい"},{"type":"hardBreak"},{"type":"text","text":"永遠の 安らぎに つつまれて  through all eternity"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"優しく 見守る 私の この手で 眠りなさい"},{"type":"hardBreak"},{"type":"text","text":"笑ってた 泣いてた 怒ってた 君の事 覚えている"},{"type":"hardBreak"},{"type":"text","text":"忘れない いつまでも 決して until my life is exhausted"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"交差点 聞こえてきた 君に よく似た声"},{"type":"hardBreak"},{"type":"text","text":"振り向いて 空を 仰ぎ見る こぼれそうな 涙こらえて"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"明日こそ いつの日か"}]}]}},"parentId":"page:page","index":"b3K4XM","typeName":"shape"},{"x":-21.96226503423398,"y":-96.64004159174212,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:a7nK8MnwYQG3M1mMkNzGr","type":"draw","props":{"segments":[{"type":"free","points":[{"x":0,"y":0,"z":0.5},{"x":-0.15,"y":0,"z":0.5},{"x":-0.3,"y":0.15,"z":0.5},{"x":-0.44,"y":0.15,"z":0.5},{"x":-0.59,"y":0.3,"z":0.5},{"x":-0.74,"y":0.44,"z":0.5},{"x":-0.89,"y":0.44,"z":0.5},{"x":-0.89,"y":0.59,"z":0.5},{"x":-1.03,"y":0.59,"z":0.5},{"x":-1.18,"y":0.74,"z":0.5},{"x":-1.33,"y":0.89,"z":0.5},{"x":-1.48,"y":1.03,"z":0.5},{"x":-1.48,"y":1.18,"z":0.5},{"x":-1.62,"y":1.18,"z":0.5},{"x":-1.62,"y":1.33,"z":0.5},{"x":-1.77,"y":1.33,"z":0.5},{"x":-1.77,"y":1.48,"z":0.5},{"x":-1.77,"y":1.62,"z":0.5},{"x":-1.92,"y":1.77,"z":0.5},{"x":-2.07,"y":1.92,"z":0.5},{"x":-2.07,"y":2.07,"z":0.5},{"x":-2.21,"y":2.21,"z":0.5},{"x":-2.36,"y":2.36,"z":0.5},{"x":-2.36,"y":2.51,"z":0.5},{"x":-2.36,"y":2.66,"z":0.5},{"x":-2.51,"y":2.8,"z":0.5},{"x":-2.51,"y":2.95,"z":0.5},{"x":-2.51,"y":2.95,"z":0.5},{"x":-2.